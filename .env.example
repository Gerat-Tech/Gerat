# =============================================================
# GERAT SOFTWARE SOLUTIONS PLC — ENVIRONMENT CONFIGURATION
# =============================================================

# Database Connection (Prisma)
# Default local SQLite: "file:./dev.db"
# Production PostgreSQL: "postgresql://USER:PASSWORD@HOST:5432/gerat_prod?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Required for production session signing)
JWT_SECRET="generate-a-secure-random-32-byte-secret-key"

# Initial Super Admin Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@gerat.et"
ADMIN_DEFAULT_PASSWORD="YourSecureAdminPassword123!"

# Public Application URL (Used for generating dossier links in alerts)
NEXT_PUBLIC_APP_URL="https://gerat.et"

# Real-Time Telemetry Alert Webhook (Optional: Slack, Discord, Telegram, or Custom)
# Can also be dynamically configured via Mission Control: /dashboard/settings
NOTIFICATION_WEBHOOK_URL=""
TELEGRAM_CHAT_ID=""
